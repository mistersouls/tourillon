<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Tourillon"
           Manufacturer="Tourillon Contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Tourillon is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="Main" Title="Tourillon" Level="1">
      <ComponentGroupRef Id="BundleFiles" />
      <ComponentRef Id="AddToPath" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tourillon" />
    </StandardDirectory>
  </Package>

  <Fragment>
    <ComponentGroup Id="BundleFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BundleDir)\**" />
    </ComponentGroup>

    <Component Id="AddToPath" Directory="INSTALLFOLDER" Guid="*">
      <util:Environment Id="TourillonPath"
                        Name="PATH"
                        Value="[INSTALLFOLDER]dist"
                        Part="last"
                        Action="set"
                        System="yes" />
    </Component>
  </Fragment>
</Wix>
